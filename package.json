    "axios": "^1.6.0",
    "bs58": "^5.0.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.12.16",
    "node-telegram-bot-api": "^0.64.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "ts-node": "^10.9.2",
