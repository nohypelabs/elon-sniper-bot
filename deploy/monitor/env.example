# Copy to ~/.config/minipc-monitor/env (chmod 600). Never commit the real file: it holds the bot token.
MM_HOST=user@host-or-tailscale-ip
MM_PORT=22
MM_KEY=$HOME/.ssh/your_deploy_key
MM_NAME=minipc
MM_SERVICE=elon-sniper
MM_TG_TOKEN=telegram-bot-token
MM_TG_CHAT=telegram-chat-id
# optional: MM_FAIL_THRESHOLD=3  MM_REMIND_MIN=30  MM_STALE_LOG_SEC=300
